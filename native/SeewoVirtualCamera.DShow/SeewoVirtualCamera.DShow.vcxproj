<?xml version="1.0" encoding="utf-8"?>
<!--
  SeewoVirtualCamera.DShow.vcxproj

  The DirectShow virtual camera. Builds with a plain:

      msbuild SeewoVirtualCamera.DShow.vcxproj /p:Configuration=Release /p:Platform=x64

  There is deliberately no dependency on the DirectShow base classes or on any
  installed SDK sample: the filter implements every interface itself and links
  only against the Windows SDK import libraries. That keeps the build hermetic on
  a bare GitHub Actions runner. See README.md.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6D1F2A44-9C3B-4E7D-9A15-3C8B5E0F7A22}</ProjectGuid>
    <RootNamespace>SeewoVirtualCameraDShow</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- Configuration type and toolset, per configuration so a Win32 build gets a
       real 32-bit DLL rather than a mislabelled x64 one. -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <!-- The repository root is always two levels up from this project, which
         lives at <repo>
ative\<Project>. Deriving it from the project
         directory rather than SolutionDir is deliberate: MSBuild sets
         SolutionDir to the *project* directory when a .vcxproj is built
         directly, which would silently redirect the output into
         native\<Project>artifacts instead of the repository artifacts
         folder that CI collects. -->
    <RepoRoot>$(MSBuildProjectDirectory)\..\..\</RepoRoot>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$(RepoRoot)artifacts\native\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RepoRoot)artifacts\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>SeewoVirtualCamera.DShow</TargetName>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(ProjectDir)..\SeewoCommon;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;_WINDOWS;_USRDLL;SEEWO_DSHOW_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>SeewoVirtualCamera.DShow.def</ModuleDefinitionFile>
      <AdditionalDependencies>strmiids.lib;quartz.lib;ole32.lib;oleaut32.lib;uuid.lib;advapi32.lib;user32.lib;gdi32.lib;winmm.lib;shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="SeewoDShowFilter.cpp" />
    <ClCompile Include="SeewoOutputPin.cpp" />
    <ClCompile Include="SeewoFrameSource.cpp" />
    <!-- Compiled directly rather than linked from a sibling lib so this project
         has no build-order dependency on any other target. -->
    <ClCompile Include="..\SeewoCommon\SeewoIpc.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="SeewoDShowFilter.h" />
    <ClInclude Include="SeewoOutputPin.h" />
    <ClInclude Include="SeewoFrameSource.h" />
    <ClInclude Include="..\SeewoCommon\SeewoIpc.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SeewoVirtualCamera.DShow.def" />
    <None Include="README.md" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>

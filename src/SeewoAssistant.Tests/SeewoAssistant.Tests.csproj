<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The tests exercise pure logic, so they run on the CI Linux job too if
         needed; the Windows-only APIs are guarded at runtime. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- A swapped Assert.Equal argument order still passes and still reads as though it
         were right, so it hides exactly the contract mismatch these tests exist to catch.
         The four contract assertions in SharedChannelContractTests had it, and the only
         sign was an analyzer warning that nothing acted on. Promoted to an error so the
         next one fails the build instead of being scrolled past. -->
    <WarningsAsErrors>$(WarningsAsErrors);xUnit2000</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeewoAssistant.Core\SeewoAssistant.Core.csproj" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SeewoAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="希沃助手">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: a drag region with the app name, plus the window buttons. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                <TextBlock Text="希沃助手" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="ElevationBadge"
                        Style="{StaticResource StatusBadgeStyle}"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ElevationBadgeText"
                               FontSize="11"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Border>
            </StackPanel>

            <!-- Nothing to the right of the product name.

                 This slot held the current page's name. It was added to fix a real bug -
                 a status sentence appearing at both the top and the bottom of the same
                 page - but the navigation pane already highlights the page you are on, so
                 it restated what the user could see, and it sat in the same corner the
                 window buttons occupy in full screen. Removed at the user's request.

                 No settings or theme buttons here either: the settings page is one click
                 away in the navigation pane, so a second entry point was duplicate, and
                 in full screen the window buttons overlay this corner and covered them. -->
        </Grid>

        <!-- Side navigation. Each item is one of the five modules. -->
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="248"
                        SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="虚拟摄像头" Tag="camera" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="隐私监控" Tag="privacy">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="防截屏保护" Tag="capture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="希沃软件" Tag="seewo">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="定时任务" Tag="schedule">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="日志与诊断" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Status bar: the most recent message from any service. -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="StatusIcon"
                          Grid.Column="0"
                          Glyph="&#xE946;"
                          FontSize="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="就绪" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="PrivacyStatusText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CameraStatusText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<local:ModulePageBase
    x:Class="SeewoAssistant.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeewoAssistant.Pages">

    <ScrollViewer Padding="32,24,32,48">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="常规行为、各模块默认值，以及配置文件的存放位置。" />

            <!-- ============================== general ============================== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="常规" Style="{StaticResource CardTitleStyle}" />

                    <ComboBox x:Name="CloseBehaviorCombo" Header="关闭主窗口时" Width="280" />

                    <ToggleSwitch x:Name="RunAtStartupToggle"
                                  Header="开机自动启动"
                                  AutomationProperties.Name="开机自动启动"
                                  OnContent="已开启"
                                  OffContent="已关闭" />

                    <TextBlock x:Name="RunAtStartupHint"
                               Style="{StaticResource CardBodyStyle}"
                               FontSize="12" />

                    <ToggleSwitch x:Name="StartMinimizedToggle"
                                  Header="启动时最小化到托盘"
                                  AutomationProperties.Name="启动时最小化到托盘"
                                  OnContent="已开启"
                                  OffContent="已关闭" />

                    <!-- The theme picker lives here now. It used to be a button in the
                         title bar, which was unreachable in full screen because the window
                         buttons are drawn over that corner. -->
                    <ComboBox x:Name="ThemeCombo"
                              Header="外观主题"
                              Width="280"
                              SelectionChanged="OnThemeChanged"
                              AutomationProperties.Name="外观主题" />

                    <TextBlock x:Name="ThemeHint"
                               Style="{StaticResource CardBodyStyle}"
                               FontSize="12" />

                    <!-- The pages explain themselves once on first open instead of
                         carrying a permanent paragraph. This is the way back to those
                         explanations, which is what makes switching them off safe. -->
                    <ToggleSwitch x:Name="ShowPageIntrosToggle"
                                  Header="首次进入页面时显示功能说明"
                                  AutomationProperties.Name="首次进入页面时显示功能说明"
                                  OnContent="已开启"
                                  OffContent="已关闭" />

                    <Button x:Name="ReplayIntrosButton"
                            Click="OnReplayIntros"
                            AutomationProperties.Name="重新显示全部功能说明">
                        <TextBlock Text="重新显示全部功能说明" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================== system integration ============================== -->
            <!-- The native components register into HKLM and the CLSID is machine-wide, so a
                 second (or portable) copy silently takes the registration over. This card is
                 the only place the user can see where it currently points and put it back. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="系统集成" Style="{StaticResource CardTitleStyle}" />

                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="解压即用的发行包不会自己写系统和用户目录里的这些东西，所以在这里管理。注册组件需要管理员权限，会弹出系统提权提示；快捷方式和「应用和功能」记录都只写到当前用户，不需要提权。" />

                    <TextBlock x:Name="SystemIntegrationStatusText"
                               Style="{StaticResource CardBodyStyle}"
                               FontSize="12"
                               IsTextSelectionEnabled="True" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RegisterToCurrentFolderButton"
                                Click="OnRegisterToCurrentFolder"
                                AutomationProperties.Name="注册到当前目录（需要管理员）"
                                Content="注册到当前目录（需要管理员）" />

                        <Button x:Name="CleanupSystemChangesButton"
                                Click="OnCleanupSystemChanges"
                                AutomationProperties.Name="清除本工具对系统的所有改动"
                                Content="清除本工具对系统的所有改动" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CreateDesktopShortcutButton"
                                Click="OnCreateDesktopShortcut"
                                AutomationProperties.Name="在桌面创建快捷方式"
                                Content="在桌面创建快捷方式" />

                        <Button x:Name="CreateStartMenuShortcutButton"
                                Click="OnCreateStartMenuShortcut"
                                AutomationProperties.Name="在开始菜单创建快捷方式"
                                Content="在开始菜单创建快捷方式" />

                        <Button x:Name="RemoveShortcutsButton"
                                Click="OnRemoveShortcuts"
                                AutomationProperties.Name="移除快捷方式"
                                Content="移除快捷方式" />

                        <Button x:Name="ToggleAppsAndFeaturesButton"
                                Click="OnToggleAppsAndFeatures"
                                AutomationProperties.Name="在「应用和功能」中显示/隐藏"
                                Content="在「应用和功能」中显示/隐藏" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================== camera ============================== -->
            <TextBlock Text="虚拟摄像头默认值" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="这些是程序启动时和托盘快捷开关使用的默认画面设置。" />

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ComboBox x:Name="DefaultResolutionCombo" Header="默认分辨率" Width="200" />
                        <ComboBox x:Name="DefaultFpsCombo" Header="默认帧率" Width="140" />
                    </StackPanel>

                    <TextBox x:Name="DefaultColorBox" Header="默认颜色（#RRGGBB）" Width="200" />

                    <TextBox x:Name="DefaultImageBox"
                             Header="默认图片路径（留空则使用颜色）"
                             PlaceholderText="C:\Pictures\logo.png" />
                </StackPanel>
            </Border>

            <!-- ============================== privacy ============================== -->
            <TextBlock Text="隐私监控默认值" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <ToggleSwitch x:Name="MonitorCameraToggle" Header="监控摄像头" OnContent="已开启" OffContent="已关闭" AutomationProperties.Name="监控摄像头" />
                    <ToggleSwitch x:Name="MonitorMicrophoneToggle" Header="监控麦克风" OnContent="已开启" OffContent="已关闭" AutomationProperties.Name="监控麦克风" />
                    <ToggleSwitch x:Name="PrivacyAutoStartToggle" Header="随程序启动自动开启监控" OnContent="已开启" OffContent="已关闭" AutomationProperties.Name="随程序启动自动开启监控" />
                    <ToggleSwitch x:Name="ResolvePidsToggle"
                                  Header="精确归因进程（需要管理员权限）"
                                  AutomationProperties.Name="精确归因进程（需要管理员权限）"
                                  OnContent="已开启"
                                  OffContent="已关闭" />
                    <ToggleSwitch x:Name="ShowToastToggle" Header="显示系统通知" OnContent="已开启" OffContent="已关闭" AutomationProperties.Name="显示系统通知" />
                    <ToggleSwitch x:Name="ShowBannerToggle"
                                  Header="显示醒目横幅（不受专注助手影响）"
                                  AutomationProperties.Name="显示醒目横幅（不受专注助手影响）"
                                  OnContent="已开启"
                                  OffContent="已关闭" />
                    <ToggleSwitch x:Name="PlaySoundToggle" Header="播放提示音" OnContent="已开启" OffContent="已关闭" AutomationProperties.Name="播放提示音" />

                    <NumberBox x:Name="BannerSecondsBox"
                               Header="横幅显示时长（秒）"
                               Minimum="2"
                               Maximum="60"
                               SpinButtonPlacementMode="Compact"
                               Width="200" />

                    <MenuFlyoutSeparator />

                    <TextBlock Text="不提醒的程序" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="按可执行文件名或完整路径匹配。列表中的程序使用摄像头/麦克风时不会弹提醒。" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NewExclusionBox" Width="360" PlaceholderText="例如 Zoom.exe" />
                        <Button x:Name="AddExclusionButton" Click="OnAddExclusion" Content="添加" />
                    </StackPanel>

                    <ListView x:Name="ExclusionList" MaxHeight="200" SelectionMode="None"
                    ItemContainerStyle="{StaticResource AccessibleListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                    <Button Grid.Column="1"
                                            Click="OnRemoveExclusion"
                                            Tag="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="移除"
                                            AutomationProperties.Name="移除">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- ============================== capture ============================== -->
            <TextBlock Text="防截屏默认值" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <ComboBox x:Name="CaptureModeCombo" Header="默认保护模式" Width="360" />

                    <ToggleSwitch x:Name="AllowCrossProcessToggle"
                                  Header="允许跨进程注入（默认关闭）"
                                  AutomationProperties.Name="允许跨进程注入（默认关闭）"
                                  OnContent="已开启"
                                  OffContent="已关闭"
                                  Toggled="OnAllowCrossProcessToggled" />

                    <InfoBar x:Name="CrossProcessInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" />

                    <Button x:Name="ResetAckButton" Click="OnResetAcknowledgement"
                    AutomationProperties.Name="重置跨进程风险确认">
                        <TextBlock Text="重置跨进程风险确认" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================== storage ============================== -->
            <TextBlock Text="文件与存储" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="配置文件" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SettingsPathText"
                                   Style="{StaticResource MonospaceStyle}" FontSize="12"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="日志文件" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LogPathText"
                                   Style="{StaticResource MonospaceStyle}" FontSize="12"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenSettingsFolderButton" Click="OnOpenSettingsFolder" Content="打开配置文件夹" />
                        <Button x:Name="OpenLogFolderButton" Click="OnOpenLogFolder" Content="打开日志文件夹" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================== actions ============================== -->
            <TextBlock Text="保存与重置" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="保存设置">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="保存设置" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ReloadButton" Click="OnReload" Content="放弃修改并重新加载" />

                        <Button x:Name="ResetButton" Click="OnResetDefaults" Content="恢复默认设置" />
                    </StackPanel>

                    <TextBlock x:Name="SaveStatusText"
                               Style="{StaticResource CardBodyStyle}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- ============================== about ============================== -->
            <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="希沃助手 (SeewoAssistant)" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="管住摄像头、麦克风和屏幕内容，顺带收拾希沃那套软件和一串定时任务。" />
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="使用 WinUI 3 与 Windows App SDK 构建，界面为简体中文，浅色为主并跟随系统深色主题。" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CardBodyStyle}" FontSize="12" />
                    <TextBlock x:Name="NativeStatusText" Style="{StaticResource CardBodyStyle}" FontSize="12" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</local:ModulePageBase>

<?xml version="1.0" encoding="utf-8"?>
<local:ModulePageBase
    x:Class="SeewoAssistant.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeewoAssistant.Pages">

    <ScrollViewer Padding="32,24,32,48">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="日志与诊断" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="查看运行日志、检查各项能力是否可用，并导出诊断信息以便排查问题。" />

            <!-- Environment summary. This is the first thing to look at when
                 something does not work, so it is shown without any interaction. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="运行环境" Style="{StaticResource CardTitleStyle}" />

                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="操作系统" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsVersionText" IsTextSelectionEnabled="True" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="进程架构" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ArchitectureText" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="管理员权限" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ElevationText" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="虚拟摄像头" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CameraCapabilityText" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="跨进程防截屏" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PayloadText" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="配置文件" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SettingsPathText"
                                   Style="{StaticResource MonospaceStyle}" FontSize="12"
                                   IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Capability checks. Each is a real probe, not a version comparison. -->
            <TextBlock Text="能力自检" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="逐项验证各模块依赖的系统能力。任何一项显示为不可用，都会在对应页面给出说明。" />

                    <Button x:Name="RunChecksButton" Click="OnRunChecks" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="运行自检">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                            <TextBlock Text="运行自检" />
                        </StackPanel>
                    </Button>

                    <ProgressRing x:Name="CheckProgress" IsActive="False" Width="20" Height="20" HorizontalAlignment="Left" />

                    <StackPanel x:Name="CheckResultsPanel" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- Live log -->
            <TextBlock Text="运行日志" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="最近的日志（最多 1000 行）" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="LogPathText"
                                       Style="{StaticResource CardBodyStyle}"
                                       FontSize="12"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="AutoScrollToggle" OnContent="自动滚动" OffContent="自动滚动" IsOn="True" AutomationProperties.Name="自动滚动日志" />
                            <Button x:Name="RefreshLogButton" Click="OnRefreshLog" Content="刷新" />
                            <Button x:Name="ClearLogButton" Click="OnClearLog" Content="清空显示" />
                            <Button x:Name="OpenLogFolderButton" Click="OnOpenLogFolder" Content="打开日志文件夹" />
                            <Button x:Name="CopyLogButton" Click="OnCopyLog" Content="复制全部" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            MaxHeight="380">
                        <ScrollViewer x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText"
                                       Style="{StaticResource MonospaceStyle}"
                                       FontSize="12"
                                       IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Export -->
            <TextBlock Text="导出诊断信息" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="把运行环境、能力自检结果和最近日志打包成一个文本文件，便于附在问题反馈里。文件中不包含任何个人文件内容。" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ExportButton" Click="OnExport" Style="{StaticResource AccentButtonStyle}">
                            <TextBlock Text="导出诊断报告" />
                        </Button>

                        <Button x:Name="CopyReportButton" Click="OnCopyReport"
                        AutomationProperties.Name="复制到剪贴板">
                            <TextBlock Text="复制到剪贴板" />
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="ExportResultText"
                               Style="{StaticResource CardBodyStyle}"
                               IsTextSelectionEnabled="True"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</local:ModulePageBase>

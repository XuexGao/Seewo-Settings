<?xml version="1.0" encoding="utf-8"?>
<local:ModulePageBase
    x:Class="SeewoAssistant.Pages.CaptureGuardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SeewoAssistant.Pages">

    <local:ModulePageBase.Resources>
        <local:ProtectionStateConverter x:Key="ProtectionStateConverter" />
        <local:OwnProcessConverter x:Key="OwnProcessConverter" />
    </local:ModulePageBase.Resources>

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="防截屏保护" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="让受保护的窗口不出现在截图、录屏和屏幕共享里。适合用来遮住聊天窗口、密码框或任何不该被录进去的内容。" />

            <!-- The single most important thing to understand about this module is its
                 hard limit, so it comes before any control rather than after them. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="请先了解这个限制" Style="{StaticResource CardTitleStyle}" />

                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="Windows 提供的接口 SetWindowDisplayAffinity 只能作用于「调用它的那个进程自己的窗口」。这是操作系统的硬性规定，不是本程序的取舍。" />

                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="因此，保护本程序自己的窗口总是可以成功；而保护别的程序的窗口（例如微信、浏览器）必须先把一小段载荷注入到对方进程里，再由对方进程去调用同一个接口。" />

                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="注入默认是关闭的，必须由你在这里手动打开。开启后仍然存在这些风险：杀毒软件和安全软件可能直接拦截它；部分系统进程会被拒绝注入；某些以更高权限运行的进程即使注入成功也会调用失败。" />

                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Title="一句话总结"
                             Message="本程序自己的窗口：稳定可用。其他程序的窗口：属于实验性功能，受杀毒软件和系统权限影响，不保证成功。" />
                </StackPanel>
            </Border>

            <!-- Own-window demo: the path that always works. -->
            <TextBlock Text="保护本程序窗口（推荐先试这个）" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="对本程序自己的主窗口应用保护，不需要注入，也不会被安全软件拦截。这是验证功能是否有效的安全路径。" />

                    <TextBlock x:Name="OwnWindowText"
                               Style="{StaticResource MonospaceStyle}"
                               FontSize="12"
                               IsTextSelectionEnabled="True" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ProtectOwnButton" Click="OnProtectOwnWindow" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="保护本程序窗口">
                            <TextBlock Text="保护本程序窗口" />
                        </Button>

                        <Button x:Name="UnprotectOwnButton" Click="OnUnprotectOwnWindow"
                        AutomationProperties.Name="取消保护">
                            <TextBlock Text="取消保护" />
                        </Button>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="验证方法：点「保护本程序窗口」后，按 Win+Shift+S 截图并框选本窗口所在的区域。窗口区域会变成空白或黑色；点「取消保护」后再截一次就恢复正常。" />
                </StackPanel>
            </Border>

            <!-- Mode. -->
            <TextBlock Text="保护方式" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <RadioButtons x:Name="ModeRadio" SelectionChanged="OnModeChanged">
                        <RadioButton x:Name="ExcludeModeRadio" Content="穿透隐身" />
                        <RadioButton x:Name="BlackoutModeRadio" Content="黑块遮蔽" />
                    </RadioButtons>

                    <TextBlock x:Name="ModeDescriptionText" Style="{StaticResource CardBodyStyle}" />

                    <InfoBar x:Name="ModeInfoBar"
                             IsOpen="False"
                             IsClosable="False"
                             Severity="Informational" />
                </StackPanel>
            </Border>

            <!-- Cross-process opt-in. -->
            <TextBlock Text="跨进程保护（实验性）" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="允许保护其他程序的窗口" FontWeight="SemiBold" />
                            <TextBlock x:Name="CrossProcessStateText" Style="{StaticResource CardBodyStyle}" />
                        </StackPanel>

                        <Border x:Name="CrossProcessBadge" Grid.Column="1" Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock x:Name="CrossProcessBadgeText" FontSize="12" />
                        </Border>
                    </Grid>

                    <ToggleSwitch x:Name="CrossProcessToggle"
                                  Header="开启跨进程注入"
                                  AutomationProperties.Name="开启跨进程注入"
                                  OnContent="已开启"
                                  OffContent="已关闭"
                                  Toggled="OnCrossProcessToggled" />

                    <TextBlock x:Name="CrossProcessAvailabilityText" Style="{StaticResource CardBodyStyle}" />
                </StackPanel>
            </Border>

            <!-- Window picker. -->
            <TextBlock Text="窗口列表" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="列出当前可见的顶层窗口。选择一行后即可对它应用或取消保护。列表是刷新时的快照，窗口关闭后该行会失效。" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RefreshWindowsButton" Click="OnRefreshWindows"
                        AutomationProperties.Name="刷新窗口列表">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新窗口列表" />
                            </StackPanel>
                        </Button>

                        <TextBox x:Name="WindowFilterBox"
                                 Width="280"
                                 PlaceholderText="按标题、进程名或类名筛选"
                                 TextChanged="OnWindowFilterChanged" />

                        <TextBlock x:Name="WindowCountText"
                                   Style="{StaticResource CardBodyStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ListView x:Name="WindowList"
                              MaxHeight="320"
                              SelectionMode="Single"
                              SelectionChanged="OnWindowSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Style="{StaticResource CardBodyStyle}"
                                                       FontSize="12" />
                                            <TextBlock Text="·" Style="{StaticResource CardBodyStyle}" FontSize="12" />
                                            <TextBlock Text="{Binding ClassName}"
                                                       Style="{StaticResource CardBodyStyle}"
                                                       FontSize="12" />
                                            <TextBlock Text="·" Style="{StaticResource CardBodyStyle}" FontSize="12" />
                                            <TextBlock Text="{Binding HandleHex}"
                                                       Style="{StaticResource MonospaceStyle}"
                                                       FontSize="12" />
                                            <TextBlock Text="·" Style="{StaticResource CardBodyStyle}" FontSize="12" />
                                            <TextBlock Text="{Binding IsOwnProcess, Converter={StaticResource OwnProcessConverter}}"
                                                       Style="{StaticResource CardBodyStyle}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="{Binding Protection, Converter={StaticResource ProtectionStateConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="SelectedWindowText"
                               Style="{StaticResource CardBodyStyle}"
                               Text="尚未选择窗口。" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ProtectSelectedButton" Click="OnProtectSelected" IsEnabled="False"
                        AutomationProperties.Name="保护选中窗口">
                            <TextBlock Text="保护选中窗口" />
                        </Button>

                        <Button x:Name="UnprotectSelectedButton" Click="OnUnprotectSelected" IsEnabled="False"
                        AutomationProperties.Name="取消保护">
                            <TextBlock Text="取消保护" />
                        </Button>
                    </StackPanel>

                    <InfoBar x:Name="PickerInfoBar"
                             IsOpen="False"
                             IsClosable="False"
                             Severity="Informational" />
                </StackPanel>
            </Border>

            <!-- Radar picker. -->
            <TextBlock Text="雷达取景" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardBodyStyle}"
                               Text="开启后每秒约 10 次读取鼠标指针下方的窗口并实时显示。把鼠标移到目标窗口上，然后点「确定」即可选中它。" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RadarButton" Click="OnToggleRadar" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="雷达取景">
                            <TextBlock x:Name="RadarButtonText" Text="雷达取景" />
                        </Button>

                        <Button x:Name="RadarConfirmButton" Click="OnConfirmRadar" IsEnabled="False"
                        AutomationProperties.Name="确定">
                            <TextBlock Text="确定" />
                        </Button>

                        <Button x:Name="RadarCancelButton" Click="OnCancelRadar" IsEnabled="False"
                        AutomationProperties.Name="取消">
                            <TextBlock Text="取消" />
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="RadarStatusText" Style="{StaticResource CardBodyStyle}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            MinHeight="72">
                        <TextBlock x:Name="RadarPreviewText"
                                   Style="{StaticResource MonospaceStyle}"
                                   FontSize="12"
                                   Text="（未开始取景）" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Last operation. -->
            <TextBlock Text="最近一次操作结果" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="结果" Style="{StaticResource CardTitleStyle}" />

                        <Border x:Name="LastResultBadge" Grid.Column="1" Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock x:Name="LastResultBadgeText" FontSize="12" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="LastResultText"
                               Style="{StaticResource CardBodyStyle}"
                               IsTextSelectionEnabled="True"
                               Text="还没有执行过操作。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</local:ModulePageBase>

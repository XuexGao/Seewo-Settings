<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Card surface used by every module page. Mica supplies the window backdrop,
        so cards use a semi-transparent layer colour rather than an opaque fill,
        which keeps the depth effect visible underneath.
    -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Page-level heading. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Monospace, for hex handles and cron expressions. -->
    <Style x:Key="MonospaceStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Inline status badge, e.g. "已启用" / "未启用". -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Gives every list row an accessible name.

        A ListViewItem has no automation name of its own, so a screen reader announces the
        row as an unlabelled list item and UI Automation cannot address it by name - which
        is also why the automated sweep could not select a specific row. The test report
        saw rows exposing only their type name ("SeewoPage+ProcessItem").

        Why a keyed style plus ItemContainerStyle rather than an implicit Style:
        XamlControlsResources already defines an implicit ListViewItem style, and an
        implicit style merged later does not reliably replace it at container-generation
        time. Setting the style explicitly on each ListView's ItemContainerStyle targets
        the generated container directly and always wins.

        The name comes from the item's ToString(), which every row view model overrides to
        return the text the user sees. Binding to the item itself (rather than to a member)
        is what makes this work for all lists with one style.
    -->
    <!--
        BasedOn is required, not optional. A Style that does not inherit the default has no
        Template setter, and a ListViewItem with no template renders nothing at all - every
        list would have gone blank. DefaultListViewItemStyle is the key WinUI's own generic
        resources use for exactly this purpose.
    -->
    <Style x:Key="AccessibleListViewItemStyle"
           TargetType="ListViewItem"
           BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Card surface used by every module page. Mica supplies the window backdrop,
        so cards use a semi-transparent layer colour rather than an opaque fill,
        which keeps the depth effect visible underneath.
    -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Page-level heading. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Monospace, for hex handles and cron expressions. -->
    <Style x:Key="MonospaceStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Inline status badge, e.g. "已启用" / "未启用". -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Every list row exposes its own content as the accessible name.

        A ListViewItem has no automation name of its own, so a screen reader announces
        the row as an unlabelled list item and UI Automation cannot address it by name.
        The test report counted forty such controls across the app, which is also why
        the automated sweep could never click a specific row.

        AutomationProperties.Name is set from the item's ToString(), which each view model
        overrides to return the identifying text the user sees. A view model that does not
        override it simply contributes no name, which is the previous behaviour rather
        than a regression.
    -->
    <Style TargetType="ListViewItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
    </Style>

</ResourceDictionary>
